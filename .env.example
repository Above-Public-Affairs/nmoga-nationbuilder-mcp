# NMOGA NationBuilder MCP — environment variables
# Copy to .env for local stdio use (Claude Desktop), or set on Railway for the
# deployed HTTP service. Never commit a real .env — it's already gitignored.

# --- NationBuilder (required) ------------------------------------------------
NATIONBUILDER_SLUG=nmoga

# Static token — simplest path for local stdio use. Get one from
# NB Settings > API. Not needed if OAuth is configured (below).
NATIONBUILDER_ACCESS_TOKEN=

# --- NationBuilder OAuth (HTTP mode only — optional, static token works too) -
NATIONBUILDER_CLIENT_ID=
NATIONBUILDER_CLIENT_SECRET=
# Falls back to https://${RAILWAY_PUBLIC_DOMAIN}/oauth/callback on Railway.
NATIONBUILDER_OAUTH_CALLBACK_URL=
# Persisted automatically after a refresh — set manually only when restoring
# a session (e.g. after re-running /oauth/authorize).
NATIONBUILDER_REFRESH_TOKEN=

# --- Railway (HTTP deploy only) ----------------------------------------------
# PORT is set automatically by Railway — do not set locally, its absence is
# what selects stdio mode for local/Claude Desktop use.
PORT=

# Bearer token to protect the /sse endpoint (optional).
MCP_AUTH_TOKEN=

# Needed only so the server can persist a rotated OAuth token back to Railway
# env vars (so it survives restarts). RAILWAY_PROJECT_ID/ENVIRONMENT_ID/
# SERVICE_ID are injected automatically by Railway; only the token needs
# setting by hand. Needs write access to this service's variables.
RAILWAY_API_TOKEN=

# --- Centralized error reporting (optional, safe to omit for local dev) -----
# No-ops when unset. See the `development-guidelines:error-reporting` skill
# and /Development/CLAUDE.md for the shared production values — don't rotate
# the key without sweeping every project's Railway env at the same time.
ERROR_API_URL=https://error-reporter-production.up.railway.app/errors
ERROR_API_KEY=
