# NMOGA NationBuilder MCP — environment variables
# Copy to .env for local stdio use (Claude Desktop), or set on Railway for the
# deployed HTTP service. Never commit a real .env — it's already gitignored.

# --- NationBuilder (required) ------------------------------------------------
NATIONBUILDER_SLUG=nmoga

# Static token — for LOCAL STDIO USE ONLY (Claude Desktop). Get one from
# NB Settings > API.
#
# HTTP mode (PORT set) REFUSES TO BOOT if this is set — per-user
# NationBuilder OAuth (below) is the only supported path to /mcp now, and a
# leftover static token here would be an inert, misleading credential rather
# than a working fallback. Delete it from Railway; keep it set only in your
# local stdio .env.
NATIONBUILDER_ACCESS_TOKEN=

# --- NationBuilder OAuth (HTTP mode only — required for production) ---------
# Registers this server as a NationBuilder OAuth app. Every connecting person
# authorizes through NationBuilder's own login screen — see the "per-user
# Authorization Server" section below for how claude.ai drives that.
NATIONBUILDER_CLIENT_ID=
NATIONBUILDER_CLIENT_SECRET=
# Falls back to https://${RAILWAY_PUBLIC_DOMAIN}/oauth/callback on Railway.
# This is the ONE path registered with NationBuilder's app config — moving
# it requires updating that registration too.
NATIONBUILDER_OAUTH_CALLBACK_URL=
# HTTP mode refuses to boot if this is set (see NATIONBUILDER_ACCESS_TOKEN
# above) — same reasoning, same fix.
NATIONBUILDER_REFRESH_TOKEN=

# --- Railway (HTTP deploy only) ----------------------------------------------
# PORT is set automatically by Railway — do not set locally, its absence is
# what selects stdio mode for local/Claude Desktop use.
PORT=

# --- Per-user Authorization Server (HTTP mode only) --------------------------
# This server is an OAuth Authorization Server to claude.ai (mounted at
# /authorize, /token, /register, /.well-known/*) as well as an OAuth client
# to NationBuilder (above). Each person adds this MCP as their OWN personal
# claude.ai connector — point it at the bare /mcp URL — and claude.ai drives
# them through a real NationBuilder login. There is no shared secret and no
# URL-embedded credential; /oauth/status is public but tiered (no secrets in
# the baseline body, your own record only behind your own valid bearer).
#
# MCP_TOKEN_SIGNING_SECRET — signs the tokens this server issues to claude.ai
# (mcp_at_.../mcp_rt_...). Recommended: `openssl rand -base64 48`. Without
# it, a secret is generated and persisted to the token store on first boot —
# fine, but if the store is ever unwritable that secret becomes ephemeral,
# and every restart then forces every connected person to log into
# NationBuilder again. Setting this explicitly avoids that failure mode
# entirely, independent of the store.
MCP_TOKEN_SIGNING_SECRET=

# Optional: overrides the base URL this server advertises as its own issuer/
# resource identifier (defaults to https://${RAILWAY_PUBLIC_DOMAIN}, or
# http://localhost:$PORT with no Railway domain). Only needed behind a
# custom domain or proxy that RAILWAY_PUBLIC_DOMAIN doesn't reflect.
PUBLIC_BASE_URL=

# Optional escape hatch: a pre-provisioned OAuth client_id (paste into
# claude.ai's connector "Advanced settings") if claude.ai's Dynamic Client
# Registration (POST /register) ever misbehaves for some client. Not a
# shared-secret bypass — the NationBuilder login is still required either
# way. Currently unused by the code; documented for when it's needed.
MCP_STATIC_CLIENT_ID=

# Optional: points this server's NationBuilder-facing OAuth calls at a
# different host than https://${NATIONBUILDER_SLUG}.nationbuilder.com — used
# only for local verification against a scripted fake upstream (see
# PROJECT-STATUS.md). Never set this in production.
NB_OAUTH_BASE_URL=

# --- Token store (HTTP mode only) --------------------------------------------
# Overrides where the per-user credential store lives. Defaults to
# $RAILWAY_VOLUME_MOUNT_PATH/nb-tokens.json — a volume MUST be mounted in
# production, or every connected person's NationBuilder session is memory-
# only and a restart forces everyone to reconnect.
TOKEN_STORE_PATH=

# --- Centralized error reporting (optional, safe to omit for local dev) -----
# No-ops when unset. See the `development-guidelines:error-reporting` skill
# and /Development/CLAUDE.md for the shared production values — don't rotate
# the key without sweeping every project's Railway env at the same time.
ERROR_API_URL=https://error-reporter-production.up.railway.app/errors
ERROR_API_KEY=
